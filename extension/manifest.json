{
  "manifest_version": 3,
  "name": "Comprehension Annotator",
  "version": "0.1.0",
  "description": "Mark passages while you read and keep them, with the page, on your own disk.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Toggle annotation mode (Alt+A)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-annotation-mode": {
      "suggested_key": { "default": "Alt+A" },
      "description": "Toggle annotation mode in this tab"
    }
  },
  "web_accessible_resources": []
}
