[Unit]
Description=Comprehension annotator sink
Documentation=https://github.com/testy-cool/comprehension-annotator
After=default.target

[Service]
Type=exec
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python -m sink serve
Restart=always
RestartSec=5
# The sink is the only writer, and everything it writes lives in these two places.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO@/library %h/.config/comprehension-annotator
PrivateTmp=true
NoNewPrivileges=true
# It listens on loopback only. Nothing here needs to reach the network.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=default.target
